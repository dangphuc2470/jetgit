{
  "name": "jetgit",
  "displayName": "JetGit - IntelliJ & JetBrains Style Git Client",
  "description": "JetBrains IntelliJ-style Git integration for VS Code — visual commit graph, colored branch lines, inline blame annotations, interactive rebase, changelists, 3-way merge, and side-by-side diff viewer. Fast, reactive, and powered by Svelte 5.",
  "version": "0.1.5",
  "publisher": "phucdnh",
  "icon": "icon.png",
  "license": "MIT",
  "homepage": "https://github.com/dangphuc2470/jetgit#readme",
  "bugs": {
    "url": "https://github.com/dangphuc2470/jetgit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dangphuc2470/jetgit"
  },
  "keywords": [
    "git",
    "git log",
    "git graph",
    "git blame",
    "gitlens",
    "gitlens alternative",
    "git lens",
    "free",
    "blame annotations",
    "commit graph",
    "commit history",
    "branch graph",
    "branch visualization",
    "interactive rebase",
    "changelists",
    "intellij",
    "jetbrains",
    "webstorm",
    "pycharm",
    "diff",
    "diff viewer",
    "merge",
    "branch manager",
    "source control",
    "scm",
    "git gui",
    "git tree",
    "git history",
    "git timeline"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:.git",
    "onCommand:jetgit.openLog",
    "onCommand:jetgit.openCommit",
    "onCommand:jetgit.toggleBlame",
    "onView:jetgit.commitView",
    "onView:jetgit.branches",
    "onView:jetgit.changelists"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "JetGit",
      "properties": {
        "jetgit.fontSize.log": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 28,
          "description": "Font size in pixels for the Jet Log panel (0 = use VS Code default)."
        },
        "jetgit.fontSize.commit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 28,
          "description": "Font size in pixels for the Jet Changes (Commit) panel (0 = use VS Code default)."
        },
        "jetgit.fontSize.merge": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 28,
          "description": "Font size in pixels for 3-Way Merge, Diff Review, Rebase, and Push panels (0 = use VS Code default)."
        },
        "jetgit.ui.advanced.fetchBranch": {
          "type": "boolean",
          "default": false,
          "description": "Show 'Fetch Branch' action in remote branch context menus."
        },
        "jetgit.ui.advanced.fetchBranchShallow": {
          "type": "boolean",
          "default": false,
          "description": "Show 'Fetch Branch (--depth=1)' action in remote branch context menus."
        },
        "jetgit.ui.advanced.trackIntoCurrent": {
          "type": "boolean",
          "default": false,
          "description": "Show 'Track into <current>' action in remote branch context menus."
        },
        "jetgit.merge.noFastForward": {
          "type": "boolean",
          "default": false,
          "description": "Always create a merge commit even if the merge resolved as a fast-forward (--no-ff)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jetgit-commit",
          "title": "Jet Changes",
          "icon": "resources/commit.svg"
        }
      ],
      "panel": [
        {
          "id": "jetgit-log",
          "title": "Jet Log",
          "icon": "resources/commit.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "jetgit.openCommit",
        "title": "Open Commit Tool Window",
        "category": "JetGit",
        "icon": "$(check)"
      },
      {
        "command": "jetgit.openLog",
        "title": "Open Git Log",
        "category": "JetGit",
        "icon": "$(git-commit)"
      },
      {
        "command": "jetgit.toggleBlame",
        "title": "Toggle Blame Annotations",
        "category": "JetGit"
      },
      {
        "command": "jetgit.interactiveRebase",
        "title": "Interactive Rebase...",
        "category": "JetGit"
      },
      {
        "command": "jetgit.newChangelist",
        "title": "New Changelist...",
        "category": "JetGit",
        "icon": "$(add)"
      },
      {
        "command": "jetgit.deleteChangelist",
        "title": "Delete Changelist",
        "category": "JetGit",
        "icon": "$(trash)"
      },
      {
        "command": "jetgit.setActiveChangelist",
        "title": "Set as Active Changelist",
        "category": "JetGit"
      },
      {
        "command": "jetgit.commitChangelist",
        "title": "Commit Changelist",
        "category": "JetGit",
        "icon": "$(check)"
      },
      {
        "command": "jetgit.refreshBranches",
        "title": "Refresh Branches",
        "category": "JetGit",
        "icon": "$(refresh)"
      },
      {
        "command": "jetgit.checkoutBranch",
        "title": "Checkout",
        "category": "JetGit"
      },
      {
        "command": "jetgit.deleteBranch",
        "title": "Delete Branch",
        "category": "JetGit"
      },
      {
        "command": "jetgit.mergeBranch",
        "title": "Merge into Current",
        "category": "JetGit"
      },
      {
        "command": "jetgit.rebaseBranch",
        "title": "Rebase Current onto...",
        "category": "JetGit"
      },
      {
        "command": "jetgit.compareBranch",
        "title": "Compare with Current",
        "category": "JetGit"
      },
      {
        "command": "jetgit.createBranch",
        "title": "Create Branch...",
        "category": "JetGit",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "jetgit.resolveConflicts",
        "title": "Resolve Merge Conflicts",
        "category": "JetGit"
      },
      {
        "command": "jetgit.acceptAllNonConflicting",
        "title": "Accept All Non-Conflicting",
        "category": "JetGit"
      },
      {
        "command": "jetgit.refreshChangelists",
        "title": "Refresh Changelists",
        "category": "JetGit",
        "icon": "$(refresh)"
      },
      {
        "command": "jetgit.pushDialog",
        "title": "Push...",
        "category": "JetGit"
      },
      {
        "command": "jetgit.openSettings",
        "title": "Open Settings",
        "category": "JetGit",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "jetgit.pushDialog",
        "key": "shift+cmd+k",
        "mac": "shift+cmd+k",
        "win": "shift+ctrl+k"
      }
    ],
    "views": {
      "jetgit-commit": [
        {
          "type": "webview",
          "id": "jetgit.commitView",
          "name": "Jet Changes"
        }
      ],
      "jetgit-log": [
        {
          "type": "webview",
          "id": "jetgit.logView",
          "name": "Jet Log",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "scm": [
        {
          "id": "jetgit.branches",
          "name": "Branches"
        },
        {
          "id": "jetgit.changelists",
          "name": "Changelists",
          "when": "scmProviderCount > 0"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "jetgit.refreshBranches",
          "when": "view == jetgit.branches",
          "group": "navigation"
        },
        {
          "command": "jetgit.createBranch",
          "when": "view == jetgit.branches",
          "group": "navigation"
        },
        {
          "command": "jetgit.newChangelist",
          "when": "view == jetgit.changelists",
          "group": "navigation"
        },
        {
          "command": "jetgit.refreshChangelists",
          "when": "view == jetgit.changelists",
          "group": "navigation"
        },
        {
          "command": "jetgit.openSettings",
          "when": "view == jetgit.logView || view == jetgit.commitView || view == jetgit.branches",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jetgit.checkoutBranch",
          "when": "view == jetgit.branches && viewItem =~ /branch/",
          "group": "1_actions@1"
        },
        {
          "command": "jetgit.createBranch",
          "when": "view == jetgit.branches && viewItem =~ /branch/",
          "group": "1_actions@2"
        },
        {
          "command": "jetgit.mergeBranch",
          "when": "view == jetgit.branches && viewItem =~ /branch/",
          "group": "2_merge@1"
        },
        {
          "command": "jetgit.rebaseBranch",
          "when": "view == jetgit.branches && viewItem =~ /branch/",
          "group": "2_merge@2"
        },
        {
          "command": "jetgit.compareBranch",
          "when": "view == jetgit.branches && viewItem =~ /branch/",
          "group": "3_compare@1"
        },
        {
          "command": "jetgit.deleteBranch",
          "when": "view == jetgit.branches && viewItem =~ /branch/",
          "group": "4_delete@1"
        },
        {
          "command": "jetgit.setActiveChangelist",
          "when": "view == jetgit.changelists && viewItem == changelist",
          "group": "1_actions@1"
        },
        {
          "command": "jetgit.commitChangelist",
          "when": "view == jetgit.changelists && viewItem =~ /changelist/",
          "group": "1_actions@2"
        },
        {
          "command": "jetgit.deleteChangelist",
          "when": "view == jetgit.changelists && viewItem == changelist",
          "group": "2_delete@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build:webview": "node build-webview.mjs",
    "watch": "concurrently \"npm run watch:ext\" \"npm run watch:webview\"",
    "watch:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "watch:webview": "node build-webview.mjs",
    "lint": "eslint src/ --ext .ts",
    "test": "node --experimental-strip-types --test test/*.test.mts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.20.0",
    "esbuild-svelte": "0.9.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
